{
  "name": "cuin",
  "version": "0.0.0",
  "description": "Component Usage Inspector for React Project.",
  "type": "module",
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "turbo run build",
    "dev:ui": "turbo run dev:ui --filter=@ikuma-t/cuin",
    "dev:cli": "turbo run dev --filter=@ikuma-t/cuin",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "keywords": [],
  "author": "ikuma-t",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "lint-staged": "catalog:",
    "simple-git-hooks": "catalog:",
    "turbo": "catalog:",
    "ultracite": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.0.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "pnpm fix"
    ],
    "packages/analyzer/**/*.rs": [
      "cargo fmt --manifest-path packages/analyzer/Cargo.toml --"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm typecheck"
  }
}
