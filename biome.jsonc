{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/solid"],
  "overrides": [
    {
      "includes": ["packages/ui/src/shared/ui/**/index.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
          },
        },
      },
    },
    {
      "includes": ["packages/analyzer/bindings/**/*"],
      "linter": {
        "enabled": false,
      },
      "formatter": {
        "enabled": false,
      },
      "assist": {
        "enabled": false,
      },
    },
  ],
}
